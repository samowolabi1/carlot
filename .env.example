APP_NAME=LotLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://carlot.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laragon's MySQL 8. Create the "carlot" database first (Laragon > Database, or HeidiSQL).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carlot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# "Keep me signed in for a week" / admin "Remember me": how long the remember cookie lasts (minutes).
AUTH_REMEMBER_MINUTES=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live chat (S8). "log" works everywhere: chat falls back to polling every few seconds.
# For instant messages set this to "reverb", fill in the REVERB_* values and run
# `php artisan reverb:start` next to the app.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync runs jobs (photo processing, emails) inside the request, so nothing needs a worker
# on Laragon. Use database or redis with `composer dev` (or Horizon) to run them in the background.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Redis + Horizon replace the database queue and cache in production.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@lotlink.test"
MAIL_FROM_NAME="${APP_NAME}"

# LotLink
LOTLINK_DEFAULT_REGION=NG
LOTLINK_CURRENCY=NGN
LOTLINK_TIMEZONE=Africa/Lagos
LOTLINK_DEFAULT_PLAN=starter
LOTLINK_MEDIA_DISK=public
# Branded share-card images for cars (rendered on the media queue).
LOTLINK_SHARE_CARDS=true
# Private disk for original photo uploads. In production use r2_uploads (browsers upload
# directly with pre-signed URLs) and set LOTLINK_MEDIA_DISK=r2_media.
LOTLINK_UPLOAD_DISK=local

# Messages. "log" writes them to storage/logs/laravel.log (sign-in codes included).
# WhatsApp goes first; SMS is the fallback. OTP_CHANNEL=sms skips WhatsApp for codes.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
OTP_CHANNEL=whatsapp
SMS_DRIVER=log
TERMII_API_KEY=
TERMII_SENDER_ID=LotLink
TERMII_BASE_URL=https://api.ng.termii.com

# Google Maps JavaScript API key, restricted to your domains. Without one, the map pin
# uses phone GPS plus manual coordinates.
GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY="${GOOGLE_MAPS_BROWSER_KEY}"

# Platform admin created by the seeder, for /admin
ADMIN_EMAIL=admin@lotlink.test
ADMIN_PASSWORD=password
ADMIN_PHONE=+2348000000000

# Cloudflare R2 for car photos in production (see README → Photos in production)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_UPLOADS_BUCKET=lotlink-uploads
R2_MEDIA_BUCKET=lotlink-media
R2_MEDIA_URL=https://media.example.com

# Marketplace search. "null" searches MySQL directly (fine for Laragon); production uses
# Meilisearch: set SCOUT_DRIVER=meilisearch, then run php artisan scout:sync-index-settings
# and php artisan scout:import "App\Domain\Inventory\Models\Vehicle".
SCOUT_DRIVER=null
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# VIN decoding (NHTSA vPIC, free, no key needed)
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Budget tools (estimates shown to buyers). Defaults: 35% of spare income, 24% a year,
# 30% down over 36 months. Running-cost rates are in config/lotlink.php.
# FINANCE_AFFORDABILITY_RATIO=0.35
# FINANCE_INTEREST_RATE=24
# FINANCE_DEPOSIT_PERCENT=30
# FINANCE_TENOR_MONTHS=36
# FINANCE_FUEL_PRICE=1000

# Billing (plans, spotlights, adverts). "sandbox" shows a test checkout instead of a real provider,
# so you can try plans locally; use "live" (or the old "paystack") with your keys in production.
# Admins choose Paystack or Flutterwave for new payments in /admin → Settings → Payments;
# PAYMENT_PROVIDER is only the default until they do. Webhooks: https://your-domain/webhooks/paystack
# and https://your-domain/webhooks/flutterwave.
PAYMENT_DRIVER=sandbox
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Flutterwave: API keys, and the secret hash you set under Settings → Webhooks in its dashboard.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

REVERB_APP_ID=lotlink
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Leave VITE_REVERB_APP_KEY empty to use polling in the browser.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Continue with Google (console.cloud.google.com → Credentials → OAuth client ID, type Web application).
# Authorised redirect URI: ${APP_URL}/auth/google/callback. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push notifications (browser/phone). Run `php artisan push:vapid` to fill these in once;
# never change them afterwards or every device has to turn push on again. Empty: pushes are only logged.
VAPID_SUBJECT=mailto:support@lotlink.ng
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Mobile API (/api/v1): token lifetime in days and requests per minute per user.
SANCTUM_TOKEN_DAYS=90
API_RATE_LIMIT=120
