        { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Search cars", "url": "/cars?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "What can I afford?", "url": "/budget?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "My bookings", "url": "/bookings?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Dealer dashboard", "url": "/dealer?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
    ]
