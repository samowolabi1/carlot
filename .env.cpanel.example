# CarYard on cPanel (shared hosting). Copy to .env on the server, fill in the blanks, then run
# `php artisan key:generate` and `php artisan lotlink:deploy --seed` (first install). See docs/deploy-cpanel.md.

APP_NAME=CarYard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://caryardng.com
# Only if the site sits behind Cloudflare's proxy (orange cloud) or another proxy: "*" so HTTPS is detected.
# Leave empty when visitors reach cPanel directly.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Daily log files in storage/logs, kept 14 days.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# cPanel → MySQL Databases: create the database and user, add the user with ALL PRIVILEGES.
# Names get your cPanel username as a prefix, e.g. myuser_caryard.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_caryard
DB_USERNAME=cpaneluser_caryard
DB_PASSWORD=

# No Redis on shared hosting: sessions, cache and the queue use MySQL.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
AUTH_REMEMBER_MINUTES=10080
CACHE_STORE=database
QUEUE_CONNECTION=database
# The one-minute cron job (php artisan schedule:run) also works through the queue: no always-on worker needed.
QUEUE_VIA_CRON=true
DB_QUEUE_RETRY_AFTER=960

# No websocket server: live chat polls every few seconds.
BROADCAST_CONNECTION=log
REVERB_APP_KEY=
VITE_REVERB_APP_KEY=

# Images go to public/media (no storage:link needed). Private files stay in storage/app/private.
FILESYSTEM_DISK=local
LOTLINK_MEDIA_DISK=media
LOTLINK_UPLOAD_DISK=local
# Only if you copied the public folder's contents into public_html (method C in the guide):
# MEDIA_ROOT=/home/cpaneluser/public_html/media
LOTLINK_SHARE_CARDS=true

# No search server: search runs on MySQL.
SCOUT_DRIVER=null
SCOUT_QUEUE=false

# cPanel → Email Accounts: create e.g. no-reply@caryardng.com; "Connect Devices" shows the SMTP host and port.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.caryardng.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@caryardng.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@caryardng.com"
MAIL_FROM_NAME="${APP_NAME}"

LOTLINK_DEFAULT_REGION=NG
LOTLINK_CURRENCY=NGN
LOTLINK_TIMEZONE=Africa/Lagos
LOTLINK_DEFAULT_PLAN=starter
LOTLINK_CSP=true
ADMIN_2FA=true

# Legal pages
LEGAL_COMPANY_NAME="CarYard Technologies Limited"
LEGAL_RC_NUMBER=
LEGAL_ADDRESS="Lagos, Nigeria"
LEGAL_EMAIL=support@caryardng.com
LEGAL_PRIVACY_EMAIL=privacy@caryardng.com
LEGAL_SECURITY_EMAIL=security@caryardng.com

# The first admin (php artisan lotlink:deploy --seed). Use a strong password and change it after signing in.
ADMIN_EMAIL=admin@caryardng.com
ADMIN_PASSWORD=
ADMIN_PHONE=

# WhatsApp (Meta Cloud API) and SMS (Termii). Leave "log" until the accounts are approved.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
OTP_CHANNEL=whatsapp
SMS_DRIVER=log
TERMII_API_KEY=
TERMII_SENDER_ID=CarYard
TERMII_BASE_URL=https://api.ng.termii.com

# Payments to CarYard (plans, spotlights, adverts). "live" once the keys are in.
PAYMENT_DRIVER=sandbox
PAYMENT_PROVIDER=paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=

# Optional
GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY="${GOOGLE_MAPS_BROWSER_KEY}"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_SUBJECT=mailto:support@caryardng.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
COMPANY_REGISTRY_DRIVER=none
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api
SANCTUM_TOKEN_DAYS=90
API_RATE_LIMIT=120
VITE_APP_NAME="${APP_NAME}"
